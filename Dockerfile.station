FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /srv

COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY aq ./aq

RUN useradd --create-home --uid 10001 app \
    && mkdir -p /data/station-a /data/station-b && chown -R app:app /data /srv
USER app

ENV STATION_NAME=station-a \
    STATION_PORT=9001 \
    STATION_LOG_PATH=/data/station-a/requests.jsonl

EXPOSE 9001

HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=20 \
    CMD python -c "import os,urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:%s/healthz' % os.environ.get('STATION_PORT','9001'), timeout=2).status==200 else 1)"

CMD ["sh", "-c", "exec python -m aq.station_mock --port ${STATION_PORT:-9001}"]
